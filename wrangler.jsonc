{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pressuresense-app",
	"main": "src/index.js",
	"compatibility_date": "2026-07-05",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "pressure-sense.app", "custom_domain": true },
		{ "pattern": "relay.pressure-sense.app", "custom_domain": true }
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "RELAY",
				"class_name": "PressureSenseRelay"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PressureSenseRelay"]
		}
	]
}
